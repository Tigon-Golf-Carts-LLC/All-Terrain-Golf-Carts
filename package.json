{
  "name": "all-terrain-golf-carts",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Static site for ALL Terrain Golf Carts, built for GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "fetch-data": "tsx script/fetch-data.ts",
    "generate-seo": "tsx script/generate-seo.ts",
    "optimize-assets": "tsx script/optimize-assets.ts",
    "prerender": "tsx script/prerender.ts",
    "build": "npm run fetch-data && npm run optimize-assets && vite build && npm run prerender && npm run generate-seo",
    "build:site": "npm run optimize-assets && vite build && npm run prerender && npm run generate-seo",
    "preview": "vite preview --outDir ../dist",
    "serve": "tsx script/serve.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "verify": "tsx script/verify.ts",
    "verify:browser": "tsx script/browser-check.mts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^20.19.27",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "linkedom": "^0.18.5",
    "postcss": "^8.4.47",
    "sharp": "^0.33.5",
    "svgo": "^3.3.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "vite": "^7.3.0",
    "vitest": "^2.1.8"
  }
}
